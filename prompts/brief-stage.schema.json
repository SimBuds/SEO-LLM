{
  "_comment": "One schema per brief stage, keyed by stage name. scripts/brief_stages.sh extracts the stage's own object with jq and passes that to scripts/llm_call.sh, because response_format takes one concrete schema per call.",
  "intent": {
    "type": "object",
    "properties": {
      "topic": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "target_audience": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "reader_goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "tone": {
        "type": "string",
        "enum": [
          "Professional",
          "Authoritative",
          "Conversational",
          "Friendly",
          "Technical"
        ]
      },
      "tone_reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "required": [
      "topic",
      "target_audience",
      "reader_goal",
      "tone",
      "tone_reason"
    ],
    "additionalProperties": false
  },
  "structure": {
    "type": "object",
    "properties": {
      "sections": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "must_cover: <exact subtopic> | competitor heading: <exact heading> | page purpose. Shape enforced by check.sh stage, not by this schema, because an enum here forced the bare category that verified nothing."
            }
          },
          "required": [
            "heading",
            "purpose",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "faq_questions": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "gaps": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "required": [
      "sections",
      "faq_questions",
      "gaps"
    ],
    "additionalProperties": false
  },
  "targets": {
    "type": "object",
    "properties": {
      "keywords": {
        "type": "array",
        "minItems": 3,
        "maxItems": 6,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "cta": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "cta_reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "required": [
      "keywords",
      "cta",
      "cta_reason"
    ],
    "additionalProperties": false
  },
  "facts": {
    "type": "object",
    "properties": {
      "facts": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "omitted": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "required": [
      "facts",
      "omitted"
    ],
    "additionalProperties": false
  }
}
