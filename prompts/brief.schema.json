{
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "target_audience": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "enum": [
        "Professional",
        "Authoritative",
        "Conversational",
        "Friendly",
        "Technical"
      ]
    },
    "word_count": {
      "type": "integer",
      "minimum": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 6
    },
    "cta": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 40
    },
    "search_intent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "format",
        "angle"
      ],
      "additionalProperties": false
    },
    "must_cover": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "existing_page": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "content_type": {
      "type": "string",
      "enum": [
        "review",
        "roundup",
        "guide",
        "how-to"
      ]
    }
  },
  "required": [
    "topic",
    "target_audience",
    "tone",
    "word_count",
    "keywords",
    "cta",
    "facts"
  ],
  "additionalProperties": false
}
