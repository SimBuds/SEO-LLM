{
  "type": "object",
  "properties": {
    "primary_keyword": {
      "type": "string",
      "minLength": 1
    },
    "secondary_keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 6
    },
    "intent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "blog post",
            "landing page",
            "product page",
            "category page",
            "tool",
            "video"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "how-to guide",
            "listicle",
            "comparison",
            "ultimate guide",
            "calculator or template",
            "informational page"
          ]
        },
        "angle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": ["type", "format", "angle"],
      "additionalProperties": false
    },
    "business_potential": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": ["score", "reason"],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "must_cover": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 12
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "primary_keyword",
    "secondary_keywords",
    "intent",
    "business_potential",
    "questions",
    "must_cover",
    "rationale"
  ],
  "additionalProperties": false
}
